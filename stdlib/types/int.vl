module int {
    class Int {
        [[get, visible]] I16 value;

        OnAlloc(I16 val) {
            value = val;
        }

        I16 Abs() {
            I16 result = 0;
            ASM(
                [[in]] R0 = value;
                [[out]] R0 = result;
            ) {
                ABS R0, R0
            }
            ret result;
        }

        I16 Negate() {
            ret 0 - value;
        }

        I8 IsPositive() {
            if (value > 0) {
                ret 1;
            }
            ret 0;
        }

        I8 IsNegative() {
            if (value < 0) {
                ret 1;
            }
            ret 0;
        }

        I8 IsZero() {
            if (value == 0) {
                ret 1;
            }
            ret 0;
        }

        I16 Add(I16 other) {
            ret value + other;
        }

        I16 Sub(I16 other) {
            ret value - other;
        }

        I16 Mul(I16 other) {
            ret value * other;
        }

        I16 Div(I16 other) {
            ret value / other;
        }

        I16 Mod(I16 other) {
            ret value % other;
        }

        I16 Square() {
            ret value * value;
        }

        I8 IsEven() {
            if (value % 2 == 0) {
                ret 1;
            }
            ret 0;
        }

        I8 IsOdd() {
            if (value % 2 != 0) {
                ret 1;
            }
            ret 0;
        }

        I8 Equals(I16 other) {
            if (value == other) {
                ret 1;
            }
            ret 0;
        }

        I8 LessThan(I16 other) {
            if (value < other) {
                ret 1;
            }
            ret 0;
        }

        I8 GreaterThan(I16 other) {
            if (value > other) {
                ret 1;
            }
            ret 0;
        }

        I16 Compare(I16 other) {
            if (value < other) {
                ret 0 - 1;
            }
            if (value > other) {
                ret 1;
            }
            ret 0;
        }

        I16 AbsDiff(I16 other) {
            if (value > other) {
                ret value - other;
            }
            ret other - value;
        }

        I16 MinWith(I16 other) {
            I16 result = 0;
            ASM(
                [[in]] R0 = value;
                [[in]] R1 = other;
                [[out]] R0 = result;
            ) {
                MIN R0, R0, R1
            }
            ret result;
        }

        I16 MaxWith(I16 other) {
            I16 result = 0;
            ASM(
                [[in]] R0 = value;
                [[in]] R1 = other;
                [[out]] R0 = result;
            ) {
                MAX R0, R0, R1
            }
            ret result;
        }

        I16 Clamp(I16 lo, I16 hi) {
            if (value < lo) {
                ret lo;
            }
            if (value > hi) {
                ret hi;
            }
            ret value;
        }

        I8 Between(I16 lo, I16 hi) {
            if (value < lo) {
                ret 0;
            }
            if (value > hi) {
                ret 0;
            }
            ret 1;
        }

        I16 GcdWith(I16 other) {
            I16 a = value;
            I16 b = other;
            if (a < 0) {
                a = 0 - a;
            }
            if (b < 0) {
                b = 0 - b;
            }
            while (b != 0) {
                I16 r = a % b;
                a = b;
                b = r;
            }
            ret a;
        }
    }
}
