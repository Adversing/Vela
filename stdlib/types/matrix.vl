module matrix {
    class Matrix {
        Ptr<I16> data;
        [[get, visible]] I16 rows;
        [[get, visible]] I16 cols;

        OnAlloc(I16 r, I16 c) {
            rows = r;
            cols = c;
            I16 total = r * c;
            I16 bytes = total * 2;
            data = Cast<Ptr<I16>>(Malloc(bytes));
        }

        OnFree {
            Free(data);
        }

        I16 Get(I16 row, I16 col) {
            I16 offset = row * cols;
            I16 index = offset + col;
            ret data[index];
        }

        U0 Set(I16 row, I16 col, I16 value) {
            I16 offset = row * cols;
            I16 index = offset + col;
            data[index] = value;
        }

        I16 Size() {
            ret rows * cols;
        }

        I8 IsSquare() {
            if (rows == cols) {
                ret 1;
            }
            ret 0;
        }

        U0 Fill(I16 value) {
            I16 total = rows * cols;
            I16 i = 0;
            while (i < total) {
                data[i] = value;
                i = i + 1;
            }
        }

        I16 Sum() {
            I16 total = rows * cols;
            I16 result = 0;
            I16 i = 0;
            while (i < total) {
                I16 elem = data[i];
                result = result + elem;
                i = i + 1;
            }
            ret result;
        }

        // software matrix multiply: C[i][j] = sum_k(A[i][k] * B[k][j])
        // Returns pointer to new data buffer of size rows * otherCols
        // this must be reworked to use actual matrix accelerator hardware 
        I16 MulWith(I16 otherData, I16 otherRows, I16 otherCols) {
            Ptr<I16> other = Cast<Ptr<I16>>(otherData);
            I16 rC = rows;
            I16 cC = otherCols;
            I16 kMax = cols;
            I16 totalC = rC * cC;
            I16 bytesC = totalC * 2;
            Ptr<I16> result = Cast<Ptr<I16>>(Malloc(bytesC));
            I16 i = 0;
            while (i < rC) {
                I16 j = 0;
                while (j < cC) {
                    I16 acc = 0;
                    I16 k = 0;
                    while (k < kMax) {
                        I16 aOff = i * kMax;
                        I16 aIdx = aOff + k;
                        I16 aVal = data[aIdx];
                        I16 bOff = k * cC;
                        I16 bIdx = bOff + j;
                        I16 bVal = other[bIdx];
                        I16 prod = aVal * bVal;
                        acc = acc + prod;
                        k = k + 1;
                    }
                    I16 rOff = i * cC;
                    I16 rIdx = rOff + j;
                    result[rIdx] = acc;
                    j = j + 1;
                }
                i = i + 1;
            }
            ret Cast<I16>(result);
        }

        I16 Trace() {
            I16 result = 0;
            I16 i = 0;
            while (i < rows) {
                if (i < cols) {
                    I16 offset = i * cols;
                    I16 index = offset + i;
                    I16 elem = data[index];
                    result = result + elem;
                }
                i = i + 1;
            }
            ret result;
        }

        U0 AddScalar(I16 value) {
            I16 total = rows * cols;
            I16 i = 0;
            while (i < total) {
                I16 elem = data[i];
                data[i] = elem + value;
                i = i + 1;
            }
        }

        U0 Scale(I16 factor) {
            I16 total = rows * cols;
            I16 i = 0;
            while (i < total) {
                I16 elem = data[i];
                data[i] = elem * factor;
                i = i + 1;
            }
        }
    }
}
